# Copy to .env.local and fill in. Next loads .env.local automatically.

# Public origin recipients' mail clients hit for the open pixel + the OAuth
# callback. MUST be internet-reachable for open tracking + Google redirect to
# work. In dev use ngrok: `ngrok http 5050` and put the https URL here.
PUBLIC_BASE_URL=http://localhost:5050

# Postgres / Supabase
DATABASE_URL=postgresql://postgres@localhost:5432/coldmail

# Google OAuth (console.cloud.google.com → enable Gmail API → OAuth client,
# Web application). Scopes: gmail.send, gmail.readonly, userinfo.email.
# The redirect URI must EXACTLY equal PUBLIC_BASE_URL + the path below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/v1/accounts/oauth/callback

# AES-256-GCM key for encrypting Gmail refresh tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Per-inbox daily ceiling (safety cap under the global scheduler). The global
# hourly/daily caps, interval, send window and timezone are edited at runtime
# in the UI (/scheduler) and stored in the DB.
DAILY_LIMIT_PER_ACCOUNT=40

# --- Docker / VPS deploy only (ignored for local `npm run dev`) ---
# NODE_ENV=production
# Password for the bundled coldmail-postgres container (docker-compose.yml).
# Must match the password in DATABASE_URL, which on the VPS points at the
# container by service name, e.g.:
#   DATABASE_URL=postgresql://coldmail:<pw>@coldmail-postgres:5432/coldmail
# POSTGRES_PASSWORD=
